{
  "name": "geodesk",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web \"tsx server/index.ts\" \"vite\"",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "check:db": "tsx scripts/check-db.ts",
    "preview": "vite preview",
    "migrate:db": "tsx scripts/migrate-db.ts",
    "demo": "concurrently --kill-others-on-fail --names demo-api,demo-web \"tsx scripts/demo-server.ts\" \"vite --config vite.demo.config.ts\"",
    "smoke:demo": "node scripts/smoke-demo.mjs",
    "check:public": "node scripts/check-public-release.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "microdata-rdf-streaming-parser": "^3.0.0",
    "node-html-parser": "^7.1.0",
    "pg": "^8.23.0",
    "rdfa-streaming-parser": "^3.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "sanitize-html": "^2.17.5",
    "undici": "7.28.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "^9.2.4",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
