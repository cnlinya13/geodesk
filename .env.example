# Copy to .env.local for a confirmed local PostgreSQL database.
# The database name is checked by the API and must remain geodesk.
PGHOST=127.0.0.1
PGPORT=55432
PGDATABASE=geodesk
PGUSER=geodesk
PGPASSWORD=geodesk-local-only

# Leave these empty for tests and synthetic demo mode. Real diagnosis needs
# credentials supplied by the user to the server process only.
DOUBAO_API_KEY=
DOUBAO_MODEL_ID=
DOUBAO_API_ENDPOINT=
