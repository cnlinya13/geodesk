# Copy to .env.local to configure the local SQLite database file.
# Default: <project>/data/geodesk.db (created automatically).
# Set DATABASE_PATH to use a different file, or DATA_DIR to change the directory.
DATABASE_PATH=
DATA_DIR=

# Leave these empty for tests and synthetic demo mode. Real diagnosis needs
# credentials supplied by the user to the server process only.
DOUBAO_API_KEY=<redacted>
DOUBAO_MODEL_ID=
DOUBAO_API_ENDPOINT=
